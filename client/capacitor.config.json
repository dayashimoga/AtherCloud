{
  "appId": "io.aetherstream.app",
  "appName": "AetherStream",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "buildOptions": {
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0c10",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#0a0c10",
      "style": "DARK"
    }
  }
}
