# Build artifacts
/target/
**/target/
/client/dist/
/client/node_modules/
/client/.vite/
/crates/*/target/

# Package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Transcode cache and scratch data
/scratch/
/temp/
/sidecars/*
!/sidecars/.gitkeep
*.m3u8
!client/public/*.m3u8
!crates/**/tests/*.m3u8
# Ignore MPEG-TS video stream segments, but preserve TypeScript files
**/*.ts
!client/**/*.ts
!crates/**/*.ts

# User media storage (keep sample test fixtures, ignore large personal files)
/media_storage/*
!/media_storage/audio/
!/media_storage/audio/*.wav
!/media_storage/images/
!/media_storage/images/*.png
!/media_storage/documents/
!/media_storage/documents/*.txt

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

# Native platforms build artifacts
/client/android/.gradle/
/client/android/build/
/client/android/app/build/
/client/ios/Pods/
/client/ios/build/
/client/src-tauri/target/
